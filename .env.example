# DevQuest environment configuration
#
# Copy this file to `.env` (gitignored) for local overrides, or use the
# committed per-environment files via ENVFILE:
#   ENVFILE=.env.development npm run android:gms
#
# NEVER put real secrets in the committed .env.* files — those files hold
# non-secret, environment-specific values only (URLs, public client IDs).

# One of: development | staging | production
APP_ENV=development

# Backend API base URL (no backend exists yet — placeholder)
API_BASE_URL=https://api.dev.devquest.example

# Roblox OAuth 2.0 (Authorization Code + PKCE).
# Register the app at https://create.roblox.com/dashboard/credentials
# The client ID is public by design (PKCE flow, no client secret in the app).
ROBLOX_CLIENT_ID=REPLACE_WITH_ROBLOX_CLIENT_ID
ROBLOX_REDIRECT_URL=devquest://oauth/callback
