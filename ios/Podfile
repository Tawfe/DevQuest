# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# $RNFirebaseAsStaticFramework ensures RNFB pods link against Firebase's
# prebuilt static XCFrameworks rather than trying to build them from source.
# NOTE: Do NOT add `use_frameworks! :linkage => :static` — it forces every
# pod into a framework module and causes RNFB to break with "non-modular
# header inside framework module" and "must be imported from module" errors.
# Firebase iOS SDK 10+ ships as prebuilt XCFrameworks so use_frameworks! is
# not needed; RNFB v21+, MMKV v4, and AppAuth are all ObjC/C++ with no Swift.
$RNFirebaseAsStaticFramework = true
# COPPA: use FirebaseAnalytics without Ad IDs — required for Kids apps.
$RNFirebaseAnalyticsWithoutAdIdSupport = true

target 'DevQuest' do
  config = use_native_modules!

  # Firebase Swift pods (FirebaseCoreInternal, FirebaseCrashlytics, FirebaseSessions)
  # import these as modules from Swift — they need explicit module maps when not
  # using use_frameworks!.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # react-native-app-auth is an ObjC pod; without use_frameworks! we must
    # explicitly generate a module map and set the module name to 'RNAppAuth'
    # so AppDelegate.swift can `import RNAppAuth`.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-app-auth'
      target.build_configurations.each do |config|
        config.build_settings['DEFINES_MODULE'] = 'YES'
        config.build_settings['PRODUCT_MODULE_NAME'] = 'RNAppAuth'
      end
    end
  end
end
